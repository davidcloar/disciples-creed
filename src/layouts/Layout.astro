---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Disciple's Creed",
	description = 'A discipleship ministry — explaining the vision, sharing the trainings, and inviting the next step.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#content"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-parchment"
		>
			Skip to content
		</a>
		<Header />
		<main id="content" class="flex-1">
			<slot />
		</main>
		<Footer />
		<script>
			function initReveal() {
				const observer = new IntersectionObserver(
					(entries) =>
						entries.forEach((e) => {
							if (e.isIntersecting) {
								e.target.classList.add('visible');
								observer.unobserve(e.target);
							}
						}),
					{ threshold: 0.08, rootMargin: '0px 0px -24px 0px' },
				);
				document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
			}

			document.addEventListener('astro:page-load', initReveal);
		</script>
	</body>
</html>
