---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Disciple's Creed — No Reserve · No Retreat · No Regret"
	description="A discipleship ministry calling the church back to biblical disciple-making as the God-ordained means by which Christ accomplishes His mission."
>
	<!-- HERO: Text-first, logo shows as fixed background watermark -->
	<section class="relative bg-transparent px-6 pb-16 pt-24 text-center sm:pb-24 sm:pt-40">
		<div class="mx-auto max-w-2xl">
			<p class="text-xs font-medium uppercase tracking-widest text-gold">
				No Reserve · No Retreat · No Regret
			</p>
			<h1 class="mt-4 font-serif text-4xl font-medium text-parchment sm:text-5xl lg:text-6xl">
				Calling the church back to biblical disciple-making.
			</h1>
			<p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted">
				The Disciple's Creed ministry exists to serve the local church through coaching, workshops,
				and resources rooted in the God-ordained method by which Christ accomplishes His mission —
				to the ends of the earth.
			</p>
			<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
				<a
					href="/connect"
					class="rounded-full bg-gold px-6 py-3 text-sm font-medium text-ink transition-all hover:bg-gold-bright hover:shadow-[0_0_20px_rgba(198,161,92,0.35)] active:scale-95"
				>
					Disciple-Making
				</a>
				<a
					href="/trainings"
					class="text-sm font-medium text-parchment underline-offset-4 transition-colors hover:text-gold hover:underline"
				>
					Explore the trainings →
				</a>
			</div>
		</div>
	</section>

	<!-- THE CREED CARD: The hook -->
	<section class="reveal border-t border-gold-deep/20 bg-surface/40 px-6 py-20">
		<div class="mx-auto flex max-w-4xl flex-col items-center gap-12 sm:flex-row sm:gap-16">
			<div class="flex-shrink-0">
				<img
					src="/images/creed-card.png"
					alt="The Disciple's Creed Card"
					class="mx-auto w-56 rounded-xl shadow-[0_16px_48px_rgba(0,0,0,0.6)] sm:w-64"
				/>
			</div>
			<div class="text-center sm:text-left">
				<p class="text-xs font-medium uppercase tracking-widest text-gold">The Disciple's Creed</p>
				<h2 class="mt-3 font-serif text-2xl font-medium text-parchment sm:text-3xl">
					A personal declaration of what it means to follow Jesus.
				</h2>
				<p class="mt-4 text-base leading-relaxed text-muted">
					This is the creed behind the name — a confession of identity, mission, and resolve for
					every disciple of Christ. Every training offered here is built on these convictions.
				</p>
				<a
					href="/creed"
					class="mt-6 inline-block text-sm font-medium text-gold underline-offset-4 transition-colors hover:text-gold-bright hover:underline"
				>
					Read What We Believe →
				</a>
			</div>
		</div>
	</section>

	<!-- WAYS TO TRAIN -->
	<section class="reveal border-t border-gold-deep/20 bg-surface/40 px-6 py-20">
		<div class="mx-auto max-w-5xl">
			<h2 class="text-center font-serif text-2xl font-medium text-parchment sm:text-3xl">
				Ways to train
			</h2>
			<div class="mt-10 grid gap-6 sm:grid-cols-3">
				<div class="rounded-2xl border border-gold-deep/30 bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gold/50 hover:shadow-[0_8px_24px_rgba(198,161,92,0.07)]">
					<p class="font-serif text-lg text-parchment">Coaching</p>
					<p class="mt-2 text-base leading-relaxed text-muted">
						One-on-one coaching for vocational and lay church leaders — available via Zoom or
						onsite — working through the biblical foundations and practice of disciple-making.
					</p>
				</div>
				<div class="rounded-2xl border border-gold-deep/30 bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gold/50 hover:shadow-[0_8px_24px_rgba(198,161,92,0.07)]">
					<p class="font-serif text-lg text-parchment">Cohorts</p>
					<p class="mt-2 text-base leading-relaxed text-muted">
						Walk through the trainings together with a small group.
					</p>
				</div>
				<div class="rounded-2xl border border-gold-deep/30 bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gold/50 hover:shadow-[0_8px_24px_rgba(198,161,92,0.07)]">
					<p class="font-serif text-lg text-parchment">The Disciple Making Church Workshop</p>
					<p class="mt-2 text-base leading-relaxed text-muted">
						An eight-hour workshop for vocational and lay leaders covering the biblical foundations
						and practice of disciple-making across eight interactive sessions.
					</p>
				</div>
			</div>
			<div class="mt-10 text-center">
				<a
					href="/trainings"
					class="text-sm font-medium text-parchment underline-offset-4 transition-colors hover:text-gold hover:underline"
				>
					See all trainings →
				</a>
			</div>
		</div>
	</section>
</Layout>
