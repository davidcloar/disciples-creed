---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Message from the Founder — Disciple's Creed"
	description="A personal welcome from Jeff Lewis, Founder and Director of Disciple's Creed."
>
	<section class="mx-auto max-w-3xl px-6 py-20 text-center sm:py-28">
		<p class="text-xs font-medium uppercase tracking-widest text-gold">Welcome from the Founder</p>
		<h1 class="mt-3 font-serif text-4xl font-medium text-parchment sm:text-5xl">
			A Word from Jeff Lewis
		</h1>
		<p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-muted">
			Founder and Director of Disciple's Creed.
		</p>
		<div class="mx-auto mt-8 max-w-xl">
			<video
				class="w-full rounded-2xl border-2 border-white/80 shadow-[0_16px_48px_rgba(0,0,0,0.6)]"
				src="/welcome.mov"
				controls
				preload="metadata"
			></video>
		</div>
	</section>
</Layout>
