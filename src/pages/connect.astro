---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Connect — Disciple's Creed"
	description="Reach out to start discipleship, ask about a training, or support the ministry."
>
	<section class="mx-auto max-w-2xl px-6 py-20 text-center sm:py-28">
		<h1 class="font-serif text-4xl font-medium text-parchment sm:text-5xl">Let's Connect</h1>
		<p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted">
			Whether you want to start discipleship, ask about a training, or support the ministry,
			reach out below.
		</p>
	</section>

	<section class="reveal border-t border-gold-deep/20 px-6 py-20">
		<form
			name="connect"
			method="POST"
			data-netlify="true"
			netlify-honeypot="bot-field"
			class="mx-auto max-w-xl space-y-6"
		>
			<input type="hidden" name="form-name" value="connect" />
			<p class="hidden">
				<label>
					Don't fill this out if you're human: <input name="bot-field" />
				</label>
			</p>

			<div>
				<label for="name" class="block text-sm font-medium text-parchment">Name</label>
				<input
					id="name"
					name="name"
					type="text"
					required
					class="mt-2 w-full rounded-lg border border-gold-deep/40 bg-surface px-4 py-2 text-parchment transition-colors focus:border-gold focus:outline-none"
				/>
			</div>

			<div>
				<label for="email" class="block text-sm font-medium text-parchment">Email</label>
				<input
					id="email"
					name="email"
					type="email"
					required
					class="mt-2 w-full rounded-lg border border-gold-deep/40 bg-surface px-4 py-2 text-parchment transition-colors focus:border-gold focus:outline-none"
				/>
			</div>

			<div>
				<label for="interest" class="block text-sm font-medium text-parchment">I'm interested in</label>
				<select
					id="interest"
					name="interest"
					class="mt-2 w-full rounded-lg border border-gold-deep/40 bg-surface px-4 py-2 text-parchment transition-colors focus:border-gold focus:outline-none"
				>
					<option>Starting discipleship</option>
					<option>Asking about a training</option>
					<option>Supporting the ministry</option>
					<option>Something else</option>
				</select>
			</div>

			<div>
				<label for="message" class="block text-sm font-medium text-parchment">Message</label>
				<textarea
					id="message"
					name="message"
					rows="5"
					required
					class="mt-2 w-full rounded-lg border border-gold-deep/40 bg-surface px-4 py-2 text-parchment transition-colors focus:border-gold focus:outline-none"
				></textarea>
			</div>

			<button
				type="submit"
				class="rounded-full bg-gold px-6 py-3 text-sm font-medium text-ink transition-all hover:bg-gold-bright hover:shadow-[0_0_20px_rgba(198,161,92,0.35)] active:scale-95"
			>
				Send
			</button>
		</form>
	</section>

	<section class="reveal border-t border-gold-deep/20 bg-surface/40 px-6 py-20 text-center">
		<h2 class="font-serif text-2xl font-medium text-parchment sm:text-3xl">Support the Ministry</h2>
		<p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted">
			[Add a giving link here once a platform is chosen — e.g. Tithe.ly, PayPal, or a giving page
			through a partnering church.]
		</p>
	</section>
</Layout>
