---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Message Sent — Disciple's Creed"
	description="Your message has been received. Jeff Lewis will be in touch soon."
>
	<section class="mx-auto max-w-2xl px-6 py-20 text-center sm:py-28">
		<p class="text-xs font-medium uppercase tracking-widest text-gold">Message Received</p>
		<h1 class="mt-3 font-serif text-4xl font-medium text-parchment sm:text-5xl">
			Thank You
		</h1>
		<p class="mx-auto mt-6 max-w-md text-lg leading-relaxed text-muted">
			Your message has been received. Jeff Lewis will be in touch with you soon.
		</p>
		<a
			href="/"
			class="mt-10 inline-block rounded-full bg-gold px-6 py-3 text-sm font-medium text-ink transition-all hover:bg-gold-bright hover:shadow-[0_0_20px_rgba(198,161,92,0.35)] active:scale-95"
		>
			Back to Home
		</a>
	</section>
</Layout>
