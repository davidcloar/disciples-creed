---
import logoLockup from '../assets/logo-lockup.png';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-parchment">
	<div class="mx-auto max-w-5xl px-6 py-10 text-sm">
		<img src={logoLockup.src} alt="Disciple's Creed" width="1279" height="523" class="h-16 w-auto" />
		<p class="mt-4 max-w-md text-muted">
			Helping people follow Jesus and learn to make disciples of others.
		</p>
		<p class="mt-6 text-muted/70">&copy; {year} Disciple's Creed. All rights reserved.</p>
	</div>
</footer>
