---
import logoIcon from '../assets/logo-icon.png';

const navItems = [
	{ href: '/about', label: 'About' },
	{ href: '/creed', label: 'Creed' },
	{ href: '/trainings', label: 'Trainings' },
	{ href: '/resources', label: 'Resources' },
];
---

<header class="border-b border-gold-deep/30">
	<div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-5">
		<a href="/" class="flex items-center gap-2.5">
			<img src={logoIcon.src} alt="" width="24" height="33" class="h-8 w-auto" />
			<span class="flex flex-col leading-tight">
				<span class="font-serif text-xl font-medium text-parchment">Disciple's Creed</span>
				<span class="text-xs text-muted">Matt 13:52</span>
			</span>
		</a>
		<nav aria-label="Primary" class="flex flex-wrap items-center gap-6 text-sm text-parchment">
			{
				navItems.map((item) => (
					<a href={item.href} class="transition-colors hover:text-gold">
						{item.label}
					</a>
				))
			}
		</nav>
		<a
			href="/connect"
			class="rounded-full bg-gold px-5 py-2 text-sm font-medium text-ink transition-colors hover:bg-gold-bright"
		>
			Start Discipleship
		</a>
	</div>
</header>
